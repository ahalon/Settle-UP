# Security & JWT Configuration
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///./splitwise.db

# Backend Public URL (used in email activation links)
BACKEND_URL=http://127.0.0.1:8000

# Automated Cron Trigger Secret
CRON_SECRET=settleup-secret-cron-key

# Transactional Email Configuration (SMTP e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_USE_TLS=True
EMAIL_FROM=your_email@gmail.com

# Email HTTP API Keys (Recommended on cloud providers like Render)
# Brevo (300 free emails/day to any recipient, no credit card required)
BREVO_API_KEY=your_brevo_api_key_here

# Resend API Key
RESEND_API_KEY=

